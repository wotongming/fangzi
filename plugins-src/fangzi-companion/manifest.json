{
  "manifest_version": 3,
  "name": "方子助手",
  "short_name": "方子",
  "version": "0.1.0",
  "description": "在任意网页划词右键，直接把问题发给方子，搜索对症的小工具。",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "102",
  "permissions": ["contextMenus", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "方子助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

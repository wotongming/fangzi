{
  "manifest_version": 3,
  "name": "行光阅读器 LineLight Reader",
  "short_name": "行光阅读",
  "version": "0.1.0",
  "description": "专注阅读：逐行冷暖引导色、焦点行高亮、纯净去广告、本地 TTS 逐句朗读、摘录导出。仅在点图标时对当前页注入，不后台采集。",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "storage", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "行光阅读器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

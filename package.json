    "matter-js": "0.20.0",
    "onnxruntime-web": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pinia": "3.0.4",
    "qrcode-generator": "2.0.4",
    "three": "^0.186.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
